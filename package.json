{
  "name": "trace-avatar",
  "version": "0.1.6",
  "description": "Turn a list of steps into a smooth, human-looking ghost-cursor walkthrough on your real page. Element-anchored, zero dependencies.",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "node scripts/gif-worker.mjs && tsup",
    "pretypecheck": "node scripts/gif-worker.mjs",
    "pretest": "node scripts/gif-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run site && node scripts/fixtures.mjs && playwright test",
    "size": "npm run build && size-limit",
    "check": "npm run typecheck && npm test && npm run test:e2e && size-limit",
    "serve": "node scripts/serve.mjs 4173",
    "site": "node scripts/site.mjs"
  },
  "keywords": [
    "cursor",
    "ghost-cursor",
    "product-tour",
    "walkthrough",
    "demo",
    "onboarding",
    "replay",
    "avatar",
    "overlay"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "esbuild": "^0.27.7",
    "fast-check": "^4.10.2",
    "gifenc": "^1.0.3",
    "happy-dom": "^21.0.4",
    "omggif": "^1.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "sideEffects": [
    "./dist/element.*",
    "./dist/trace.min.js",
    "./dist/trace-record.min.js"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/trace.min.js",
  "jsdelivr": "./dist/trace.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./perform": {
      "types": "./dist/perform.d.ts",
      "import": "./dist/perform.js",
      "require": "./dist/perform.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js",
      "require": "./dist/studio.cjs"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js",
      "require": "./dist/export.cjs"
    },
    "./schema.json": "./schema/trace.v1.json",
    "./guides.schema.json": "./schema/guides.v1.json",
    "./package.json": "./package.json",
    "./record": {
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js",
      "require": "./dist/record.cjs"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core (ESM)",
      "path": "dist/index.js",
      "limit": "14 KB"
    },
    {
      "name": "react adapter (TraceAvatar, useTrace) + core",
      "path": "dist/react.js",
      "ignore": [
        "react"
      ],
      "limit": "14 KB",
      "import": "{ TraceAvatar, useTrace }"
    },
    {
      "name": "react TraceGuides (loader, npm)",
      "path": "dist/react.js",
      "import": "{ TraceGuides }",
      "ignore": [
        "react",
        "./perform.js",
        "./studio.js"
      ],
      "limit": "6.5 KB"
    },
    {
      "name": "CDN build",
      "path": "dist/trace.min.js",
      "limit": "14 KB"
    },
    {
      "name": "perform (core + performer)",
      "path": "dist/perform.js",
      "limit": "15.5 KB"
    },
    {
      "name": "recorder",
      "path": "dist/record.js",
      "limit": "9 KB"
    },
    {
      "name": "loader (CDN bootstrap)",
      "path": "dist/trace-auto.min.js",
      "limit": "6.5 KB"
    },
    {
      "name": "loader (npm, before the first play)",
      "path": "dist/auto.js",
      "import": "{ mount }",
      "limit": "6.5 KB",
      "ignore": [
        "./perform.js",
        "./studio.js"
      ]
    },
    {
      "name": "studio (recorder + toolbar + review; the player loads on first test play)",
      "path": "dist/studio.js",
      "import": "{ createStudio }",
      "ignore": [
        "./perform.js"
      ],
      "limit": "14.5 KB"
    },
    {
      "name": "studio CDN (trace-studio.min.js)",
      "path": "dist/trace-studio.min.js",
      "limit": "14.5 KB"
    },
    {
      "name": "export (npm, before a GIF loads its encoder)",
      "path": "dist/export.js",
      "import": "{ saveVideo }",
      "ignore": [
        "./export-gif.js"
      ],
      "limit": "4 KB"
    },
    {
      "name": "export CDN (trace-export.min.js)",
      "path": "dist/trace-export.min.js",
      "limit": "4 KB"
    },
    {
      "name": "GIF encoder chunk (trace-gif.min.js, loaded for a GIF)",
      "path": "dist/trace-gif.min.js",
      "limit": "5.5 KB"
    }
  ],
  "homepage": "https://saidiadegoke.github.io/trace-avatar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saidiadegoke/trace-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/saidiadegoke/trace-avatar/issues"
  }
}
