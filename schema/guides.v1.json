{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/trace-avatar/schema/guides.v1.json",
  "title": "trace-avatar guide manifest v1",
  "description": "The guides an app offers through trace-avatar/auto: which trace, in which modes, on which pages.",
  "type": "object",
  "required": ["version", "guides"],
  "properties": {
    "version": { "const": 1 },
    "guides": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "title", "trace"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
          "trace": {
            "oneOf": [
              { "type": "string", "minLength": 1, "pattern": "\\S", "description": "A trace URL, relative to the manifest." },
              { "type": "object", "description": "A trace object (trace.v1.json)." }
            ]
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["overlay", "perform"] },
            "description": "What the launcher offers. Default [\"overlay\"]. \"perform\" also needs mount({ perform: true })."
          },
          "pages": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "pattern": "^/" },
            "description": "Pages the launcher lists the guide on; * matches one segment. Default: every page."
          },
          "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
